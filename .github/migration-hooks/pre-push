#!/usr/bin/env python3
"""Permit only the exact authorized migration branch advertisement."""

import os
from pathlib import Path
import re
import subprocess
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "scripts"))
import repository


def guard():
    sha = os.environ["MIGRATION_SHA"]
    old = os.environ.get("MIGRATION_OLD_SHA", "0" * 40)
    ref = os.environ["MIGRATION_REF"]
    if not all(re.fullmatch(r"[0-9a-f]{40}", value) for value in (sha, old)):
        raise ValueError("Invalid literal migration SHA")
    if ref != "refs/heads/miyako-simplify-dock-tile-workflows":
        raise ValueError("Unauthorized migration ref")
    repository.verify_checkout(sha)
    relative = ".github/migration-hooks/pre-push"
    expected = repository.entries(repository.run("git", "ls-tree", "-z", sha, "--", relative))
    path = Path(relative)
    if path.is_symlink() or not os.access(path, os.X_OK) \
            or expected.get(relative, (None,))[0] != "100755" \
            or repository.actual_blob(path) != expected[relative]:
        raise ValueError("Migration guard must match its committed executable blob")
    if old != "0" * 40 and repository.run(
            "git", "rev-list", "--parents", "-n", "1", sha) != f"{sha} {old}":
        raise ValueError("Correction must be one direct child")
    trailer = "Co-authored-by: Copilot App <223556219+Copilot@users.noreply.github.com>"
    if not repository.run("git", "log", "-1", "--format=%B").rstrip().endswith(trailer):
        raise ValueError("Migration commit requires literal ending co-author")
    rows = sys.stdin.read().splitlines()
    if len(rows) != 1 or len(rows[0].split()) != 4:
        raise ValueError("Expected exactly one actual advertised update")
    local, actual, remote, advertised = rows[0].split()
    if local not in (sha, "HEAD") or (actual, remote, advertised) != (sha, ref, old):
        raise ValueError("Actual advertised old/new/ref differs from authorization")


try:
    guard()
except (KeyError, ValueError, OSError, subprocess.CalledProcessError) as error:
    print(f"Migration push stopped: {error}", file=sys.stderr)
    sys.exit(1)
